/**
 * Implements hook_cron().
 *
 * Moves on teams whose time has run out while nobody is watching.
 */
function beergame_cron() {
  $gids = db_query("SELECT gid FROM {beergame_game} WHERE status = 'running'")->fetchCol();
  foreach (entity_load('beergame_game', $gids) as $game) {
    beergame_timer_check($game);
  }
}

/**
 * Implements hook_user_delete().
 *
 * Positions held by a deleted account are handed to the computer.
 */
function beergame_user_delete($account) {
  db_update('beergame_position')
    ->fields(array('uid' => 0, 'pending_order' => NULL))
    ->condition('uid', $account->uid)
    ->execute();
}

/**
 * Menu loader: loads a Beer Game.
 *
 * @param int $gid
 *   The game ID.
 *
 * @return BeerGame|false
 *   The game, or FALSE if not found.
 */
function beergame_game_load($gid) {
  $games = entity_load('beergame_game', array($gid));
  return $games ? reset($games) : FALSE;
}

/**
 * Access callback for the game listing page.
 */
function beergame_list_access() {
  return user_access('play beer games') || beergame_facilitator_access();
}

/**
 * Access callback: whether the current person can facilitate games.
 */
function beergame_facilitator_access() {
  return user_access('facilitate beer games') || user_access('administer beer games');
}

/**
 * Determines whether a person may perform an operation on a game.
 *
 * @param string $op
 *   One of 'view', 'update', 'delete', 'play' or 'results'.
 * @param BeerGame $game
 *   The game.
 * @param object $account
 *   (optional) The account to check. Defaults to the current person.
 *
 * @return bool
 *   TRUE if access is allowed.
 */
function beergame_game_access($op, BeerGame $game, $account = NULL) {
  if (!$account) {
    $account = $GLOBALS['user'];
  }
  $manage = user_access('administer beer games', $account)
    || ($account->uid && $account->uid == $game->uid && user_access('facilitate beer games', $account));
  $play = user_access('play beer games', $account) && beergame_person_position($game, $account->uid);

  switch ($op) {
    case 'update':
    case 'delete':
      return $manage;

    case 'play':
      return (bool) $play;

    case 'results':
      return $manage || ($play && $game->status == 'finished');

    case 'view':
    default:
      return $manage || $play;
  }
}

/**
 * Returns the role labels, in supply chain order.
 *
 * @return array
 *   Labels keyed by role.
 */
function beergame_role_labels() {
  return array(
    'retailer' => t('Retailer'),
    'wholesaler' => t('Wholesaler'),
    'distributor' => t('Distributor'),
    'factory' => t('Factory'),
  );
}

/**
 * Returns the game status labels.
 *
 * @return array
 *   Labels keyed by status.
 */
function beergame_status_labels() {
  return array(
    'setup' => t('Setting up'),
    'running' => t('Running'),
    'paused' => t('Paused'),
    'finished' => t('Finished'),
  );
}

/**
 * Returns the customer demand scenarios.
 *
 * @return array
 *   Arrays with 'label' and 'description', keyed by scenario.
 */
function beergame_demand_scenarios() {
  return array(
    'step' => array(
      'label' => t('Classic step'),
      'description' => t('Steady, then steps up once and stays there. Best for first-time players: the debrief reveals that customers barely changed.'),
    ),
    'growth' => array(
      'label' => t('Steady growth'),
      'description' => t('Rises by one case every three weeks, up to 8 above the start, then levels off.'),
    ),
    'seasonal' => array(
      'label' => t('Seasonal wave'),
      'description' => t('Swings smoothly up and back down by 8 cases over a 12-week cycle.'),
    ),
    'promotion' => array(
      'label' => t('Promotion spike'),
      'description' => t('A four-week promotion lifts demand by 8 cases, then it drops back.'),
    ),
    'noisy' => array(
      'label' => t('Noisy steady'),
      'description' => t('Bounces randomly within 2 cases of a level 2 above the start, but never trends.'),
    ),
    'random' => array(
      'label' => t('Random drift'),
      'description' => t('Drifts randomly up or down each week by up to the largest change you set.'),
    ),
    'surprise' => array(
      'label' => t('Surprise me'),
      'description' => t('Any of the scenarios above is picked at random when the game starts, and kept secret until the results.'),
    ),
  );
}

/**
 * Returns the costs of an all-computer team playing a game's demand.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $weeks
 *   The number of weeks to compare over.
 *
 * @return float[]
 *   Total cost for each role, keyed by role.
 *
 * @see BeerGameEngine::benchmark()
 */
function beergame_benchmark(BeerGame $game, $weeks) {
  $benchmarks = &backdrop_static(__FUNCTION__, array());
  $key = $game->id() . ':' . $weeks;
  if (!isset($benchmarks[$key])) {
    $benchmarks[$key] = $game->engine()->benchmark($weeks);
  }
  return $benchmarks[$key];
}

/**
 * Describes a team's cost compared with the computer-only benchmark.
 *
 * @param float $cost
 *   The team's total cost.
 * @param float $benchmark
 *   The computer-only team's total cost over the same weeks.
 *
 * @return string
 *   For example "$1,200.00 better" or "$300.00 worse".
 */
function beergame_benchmark_difference($cost, $benchmark) {
  $difference = '$' . number_format(abs($benchmark - $cost), 2);
  if ($cost < $benchmark) {
    return t('@amount better', array('@amount' => $difference));
  }
  if ($cost > $benchmark) {
    return t('@amount worse', array('@amount' => $difference));
  }
  return t('The same');
}

/**
 * Returns the label of the demand scenario a game uses.
 *
 * @param BeerGame $game
 *   The game.
 *
 * @return string
 *   The scenario label. For a surprise game that has not started, "Surprise
 *   me", since no scenario has been picked yet.
 */
function beergame_demand_scenario_label(BeerGame $game) {
  $settings = $game->engine()->getSettings();
  $scenarios = beergame_demand_scenarios();
  $scenario = empty($settings['demand_scenario']) ? $settings['demand_pattern'] : $settings['demand_scenario'];
  return isset($scenarios[$scenario]) ? $scenarios[$scenario]['label'] : $scenarios['step']['label'];
}

/**
 * Describes a game's customer demand for the facilitator.
 *
 * @param BeerGame $game
 *   The game.
 *
 * @return string
 *   A sentence describing the demand. A surprise scenario stays secret until
 *   the game has finished.
 */
function beergame_demand_summary(BeerGame $game) {
  $settings = $game->engine()->getSettings();
  $scenarios = beergame_demand_scenarios();
  $scenario = $settings['demand_pattern'];
  if ($scenario == 'surprise') {
    if ($game->status != 'finished' || empty($settings['demand_scenario'])) {
      return t('Customer demand: a surprise scenario, revealed in the results.');
    }
    $scenario = $settings['demand_scenario'];
  }
  $args = array(
    '@scenario' => $scenarios[$scenario]['label'],
    '@initial' => $settings['demand_initial'],
    '@week' => $settings['demand_step_week'],
  );
  if ($scenario == 'step') {
    return t('Customer demand: @scenario, @initial cases a week, then @step from week @week.', $args + array('@step' => $settings['demand_step']));
  }
  if ($scenario == 'random') {
    return t('Customer demand: @scenario, starting at @initial and changing by up to @variation a week from week @week.', $args + array('@variation' => $settings['demand_variation']));
  }
  return t('Customer demand: @scenario, starting at @initial and changing from week @week.', $args);
}

/**
 * Returns the default settings for new games.
 *
 * @return array
 *   Settings keyed by name.
 */
function beergame_default_settings() {
  $settings = BeerGameEngine::defaultSettings();
  $config = config('beergame.settings');
  foreach (array_keys($settings) as $key) {
    if (in_array($key, array('demand_schedule', 'demand_scenario'))) {
      continue;
    }
    $value = $config->get($key);
    if ($value !== NULL) {
      $settings[$key] = $value;
    }
  }
  return $settings;
}

/**
 * Loads the teams of a game, with their positions.
 *
 * @param BeerGame $game
 *   The game.
 *
 * @return array
 *   Team objects keyed by team ID, in creation order.
 */
function beergame_teams_load(BeerGame $game) {
  if (!$game->id()) {
    return array();
  }
  $tids = db_query('SELECT tid FROM {beergame_team} WHERE gid = :gid ORDER BY tid', array(':gid' => $game->id()))->fetchCol();
  $teams = array();
  foreach ($tids as $tid) {
    $teams[$tid] = beergame_team_load($tid);
  }
  return $teams;
}

/**
 * Loads a team with its positions.
 *
 * @param int $tid
 *   The team ID.
 *
 * @return object|false
 *   The team, or FALSE if not found. $team->positions is keyed by role.
 */
function beergame_team_load($tid) {
  $team = db_query('SELECT * FROM {beergame_team} WHERE tid = :tid', array(':tid' => $tid))->fetchObject();
  if (!$team) {
    return FALSE;
  }
  $team->state = empty($team->state) ? array() : unserialize($team->state, array('allowed_classes' => FALSE));
  $team->deadline = (int) $team->deadline;
  $team->positions = array();
  foreach (array_keys(beergame_role_labels()) as $role) {
    $team->positions[$role] = (object) array('tid' => $team->tid, 'role' => $role, 'uid' => 0, 'pending_order' => NULL);
  }
  $result = db_query('SELECT * FROM {beergame_position} WHERE tid = :tid', array(':tid' => $tid));
  foreach ($result as $position) {
    $position->uid = (int) $position->uid;
    $team->positions[$position->role] = $position;
  }
  return $team;
}

/**
 * Saves a team and its positions.
 *
 * @param object $team
 *   The team. Positions in $team->positions are saved as well.
 */
function beergame_team_save($team) {
  $team->changed = REQUEST_TIME;
  if (empty($team->tid)) {
    backdrop_write_record('beergame_team', $team);
  }
  else {
    backdrop_write_record('beergame_team', $team, 'tid');
  }
  foreach ($team->positions as $role => $position) {
    db_merge('beergame_position')
      ->key(array('tid' => $team->tid, 'role' => $role))
      ->fields(array(
        'uid' => (int) $position->uid,
        'pending_order' => isset($position->pending_order) ? (int) $position->pending_order : NULL,
      ))
      ->execute();
  }
}

/**
 * Deletes a team, its positions and its history.
 *
 * @param int $tid
 *   The team ID.
 */
function beergame_team_delete($tid) {
  db_delete('beergame_log')->condition('tid', $tid)->execute();
  db_delete('beergame_position')->condition('tid', $tid)->execute();
  db_delete('beergame_team')->condition('tid', $tid)->execute();
}

/**
 * Finds the position a person plays in a game.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $uid
 *   The person's user ID.
 *
 * @return object|false
 *   An object with tid and role properties, or FALSE.
 */
function beergame_person_position(BeerGame $game, $uid) {
  $positions = &backdrop_static(__FUNCTION__, array());
  if (!$uid || !$game->id()) {
    return FALSE;
  }
  $key = $game->id() . ':' . $uid;
  if (!isset($positions[$key])) {
    $positions[$key] = db_query('SELECT p.tid, p.role FROM {beergame_position} p INNER JOIN {beergame_team} t ON t.tid = p.tid WHERE t.gid = :gid AND p.uid = :uid', array(
      ':gid' => $game->id(),
      ':uid' => $uid,
    ))->fetchObject();
  }
  return $positions[$key];
}

/**
 * Starts a game: every team begins week 1 in equilibrium.
 *
 * @param BeerGame $game
 *   The game, which must be in setup.
 */
function beergame_game_start(BeerGame $game) {
  $engine = $game->engine();
  $settings = $engine->getSettings();
  $scenario = $settings['demand_pattern'];
  if ($scenario == 'surprise') {
    $choices = BeerGameEngine::surpriseScenarios();
    $scenario = $choices[array_rand($choices)];
  }
  $game->settings['demand_scenario'] = $scenario;
  $game->settings['demand_schedule'] = $engine->demandSchedule($scenario);
  $engine = $game->engine();
  $game->status = 'running';
  $game->save();
  foreach (beergame_teams_load($game) as $team) {
    $team->state = $engine->initialState();
    $team->week = $team->state['week'];
    $team->status = 'playing';
    foreach ($team->positions as $position) {
      $position->pending_order = NULL;
    }
    beergame_team_save($team);
    // Teams made up entirely of computer players play through at once.
    beergame_team_advance($game, $team->tid);
  }
}

/**
 * Places a person's order for the current week.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $uid
 *   The person placing the order.
 * @param int $order
 *   Cases ordered.
 * @param int $week
 *   The week the person believes they are ordering for. Guards against a
 *   stale browser placing an order for the wrong week.
 *
 * @return string|true
 *   TRUE on success, or a message explaining why the order was refused.
 */
function beergame_place_order(BeerGame $game, $uid, $order, $week) {
  $position = beergame_person_position($game, $uid);
  if (!$position) {
    return t('You do not have a position in this game.');
  }
  if ($game->status != 'running') {
    return t('The game is not running right now.');
  }

  $transaction = db_transaction();
  try {
    // Lock the team so simultaneous orders cannot both advance the week.
    db_query('SELECT tid FROM {beergame_team} WHERE tid = :tid FOR UPDATE', array(':tid' => $position->tid));
    $team = beergame_team_load($position->tid);
    if ($team->status != 'playing') {
      return t('Your team has finished playing.');
    }
    if ($team->week != $week) {
      return t('That order was for week @week, but your team is now in week @current.', array('@week' => $week, '@current' => $team->week));
    }
    if (isset($team->positions[$position->role]->pending_order)) {
      return t('You have already placed your order for this week.');
    }
    $team->positions[$position->role]->pending_order = max(0, (int) $order);
    beergame_team_save($team);
    beergame_team_advance($game, $team->tid);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog_exception('beergame', $e);
    return t('Your order could not be saved. Please try again.');
  }
  return TRUE;
}

/**
 * Advances a team through every week for which all orders are in.
 *
 * Computer players order automatically. Callers should hold a lock on the
 * team row (see beergame_place_order()) when people may be ordering at the
 * same time.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $tid
 *   The team ID.
 * @param string[] $timed_out
 *   (optional) Roles whose order for the current week was placed because
 *   their time ran out.
 */
function beergame_team_advance(BeerGame $game, $tid, array $timed_out = array()) {
  $engine = $game->engine();
  $settings = $engine->getSettings();
  while ($game->status == 'running') {
    $team = beergame_team_load($tid);
    if ($team->status != 'playing') {
      break;
    }
    $orders = array();
    foreach ($team->positions as $role => $position) {
      if (!$position->uid) {
        $orders[$role] = $engine->botOrder($team->state, $role);
      }
      elseif (isset($position->pending_order)) {
        $orders[$role] = (int) $position->pending_order;
      }
      else {
        // Still waiting for a person to order.
        return;
      }
    }

    foreach ($team->state['positions'] as $role => $values) {
      db_merge('beergame_log')
        ->key(array('tid' => $tid, 'role' => $role, 'week' => $team->week))
        ->fields(array(
          'incoming_order' => $values['incoming_order'],
          'delivered' => $values['delivered'],
          'shipped' => $values['shipped'],
          'inventory' => $values['inventory'],
          'backlog' => $values['backlog'],
          'order_placed' => $orders[$role],
          'cost' => $values['cost_week'],
          'computer' => $team->positions[$role]->uid ? 0 : 1,
          'timed_out' => in_array($role, $timed_out) ? 1 : 0,
        ))
        ->execute();
    }
    // Only the first week played here can have timed out.
    $timed_out = array();

    if ($team->week >= $settings['end_week']) {
      $team->status = 'finished';
      $team->deadline = 0;
    }
    else {
      $team->state = $engine->advance($team->state, $orders);
      $team->week = $team->state['week'];
      $team->deadline = beergame_timer_deadline($game);
    }
    foreach ($team->positions as $position) {
      $position->pending_order = NULL;
    }
    beergame_team_save($team);
    module_invoke_all('beergame_week_completed', $game, $team);
  }
  beergame_game_check_finished($game);
}

/**
 * Returns when time runs out for a week starting now.
 *
 * @param BeerGame $game
 *   The game.
 *
 * @return int
 *   A Unix timestamp, or 0 when the game's timer is not running.
 */
function beergame_timer_deadline(BeerGame $game) {
  $settings = $game->engine()->getSettings();
  if (empty($game->settings['timer_running']) || !$settings['week_seconds']) {
    return 0;
  }
  return time() + $settings['week_seconds'];
}

/**
 * Returns the seconds left in a team's current week.
 *
 * @param BeerGame $game
 *   The game.
 * @param object $team
 *   The team.
 *
 * @return int|null
 *   Seconds left, or NULL when no timer is running for the team. While the
 *   game is paused, the time left when it was paused.
 */
function beergame_timer_seconds_left(BeerGame $game, $team) {
  if (empty($game->settings['timer_running']) || !$team->deadline || $team->status != 'playing') {
    return NULL;
  }
  $now = ($game->status == 'paused' && !empty($game->settings['paused_at'])) ? $game->settings['paused_at'] : time();
  return max(0, $team->deadline - $now);
}

/**
 * Starts the week timer for every team in a running game.
 *
 * Each team gets a full week's time from now.
 *
 * @param BeerGame $game
 *   The game.
 */
function beergame_timer_start(BeerGame $game) {
  $game->settings['timer_running'] = TRUE;
  $game->save();
  db_update('beergame_team')
    ->fields(array('deadline' => beergame_timer_deadline($game)))
    ->condition('gid', $game->id())
    ->condition('status', 'playing')
    ->execute();
}

/**
 * Stops the week timer, so teams can take as long as they like.
 *
 * @param BeerGame $game
 *   The game.
 */
function beergame_timer_stop(BeerGame $game) {
  $game->settings['timer_running'] = FALSE;
  $game->save();
  db_update('beergame_team')
    ->fields(array('deadline' => 0))
    ->condition('gid', $game->id())
    ->execute();
}

/**
 * Places orders for anyone in a game whose time has run out.
 *
 * Called whenever boards or the dashboard check for updates, and on cron.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $tid
 *   (optional) Only check this team.
 */
function beergame_timer_check(BeerGame $game, $tid = NULL) {
  if ($game->status != 'running' || empty($game->settings['timer_running'])) {
    return;
  }
  $query = db_select('beergame_team', 't')
    ->fields('t', array('tid'))
    ->condition('gid', $game->id())
    ->condition('status', 'playing')
    ->condition('deadline', 0, '>')
    ->condition('deadline', time(), '<=');
  if ($tid) {
    $query->condition('tid', $tid);
  }
  foreach ($query->execute()->fetchCol() as $expired_tid) {
    beergame_team_time_out($game, $expired_tid);
  }
}

/**
 * Places orders for everyone on a team who ran out of time this week.
 *
 * Each of them repeats their previous order, and the week moves on.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $tid
 *   The team ID.
 */
function beergame_team_time_out(BeerGame $game, $tid) {
  $transaction = db_transaction();
  try {
    // Lock the team so an order arriving now cannot also advance the week.
    db_query('SELECT tid FROM {beergame_team} WHERE tid = :tid FOR UPDATE', array(':tid' => $tid));
    $team = beergame_team_load($tid);
    if ($team->status != 'playing' || !$team->deadline || $team->deadline > time()) {
      return;
    }
    $engine = $game->engine();
    $timed_out = array();
    foreach ($team->positions as $role => $position) {
      if ($position->uid && !isset($position->pending_order)) {
        $position->pending_order = $engine->timeoutOrder($team->state, $role);
        $timed_out[] = $role;
      }
    }
    beergame_team_save($team);
    beergame_team_advance($game, $tid, $timed_out);
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog_exception('beergame', $e);
  }
}

/**
 * Marks a running game finished once every team has finished.
 *
 * @param BeerGame $game
 *   The game.
 */
function beergame_game_check_finished(BeerGame $game) {
  if ($game->status != 'running') {
    return;
  }
  $remaining = db_query("SELECT COUNT(*) FROM {beergame_team} WHERE gid = :gid AND status <> 'finished'", array(':gid' => $game->id()))->fetchField();
  if (!$remaining) {
    $game->status = 'finished';
    $game->save();
  }
}

/**
 * Hands a position over to the computer, e.g. when a person drops out.
 *
 * @param BeerGame $game
 *   The game.
 * @param int $tid
 *   The team ID.
 * @param string $role
 *   The role.
 */
function beergame_position_to_computer(BeerGame $game, $tid, $role) {
  $transaction = db_transaction();
  db_query('SELECT tid FROM {beergame_team} WHERE tid = :tid FOR UPDATE', array(':tid' => $tid));
  $team = beergame_team_load($tid);
  if (!$team || $team->gid != $game->id() || !isset($team->positions[$role])) {
    return;
  }
  $team->positions[$role]->uid = 0;
  $team->positions[$role]->pending_order = NULL;
  beergame_team_save($team);
  backdrop_static_reset('beergame_person_position');
  if ($team->status == 'playing') {
    beergame_team_advance($game, $tid);
  }
}

/**
 * Loads the week-by-week history of a team.
 *
 * @param int $tid
 *   The team ID.
 * @param string $role
 *   (optional) Limit to one role.
 *
 * @return array
 *   Log rows keyed by role, then by week.
 */
function beergame_team_history($tid, $role = NULL) {
  $query = db_select('beergame_log', 'l')
    ->fields('l')
    ->condition('tid', $tid)
    ->orderBy('week');
  if ($role) {
    $query->condition('role', $role);
  }
  $history = array();
  foreach ($query->execute() as $row) {
    $history[$row->role][$row->week] = $row;
  }
  return $history;
}

/**
 * Returns the display name of the person in a position.
 *
 * @param object $position
 *   The position.
 *
 * @return string
 *   The person's name, or "Computer".
 */
function beergame_position_player_name($position) {
  if (!$position->uid) {
    return t('Computer');
  }
  $account = user_load($position->uid);
  return $account ? user_format_name($account) : t('Unknown');
}
