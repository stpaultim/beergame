<?php
/**
 * @file
 * A multiplayer online version of the Beer Distribution Game.
 */

/**
 * Implements hook_autoload_info().
 */
function beergame_autoload_info() {
  return array(
    'BeerGameEngine' => 'includes/BeerGameEngine.php',
    'BeerGame' => 'includes/BeerGame.php',
    'BeerGameStorageController' => 'includes/BeerGame.php',
  );
}

/**
 * Implements hook_config_info().
 */
function beergame_config_info() {
  $prefixes['beergame.settings'] = array(
    'label' => t('Beer Game settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_permission().
 */
function beergame_permission() {
  return array(
    'administer beer games' => array(
      'title' => t('Administer Beer Games'),
      'description' => t('Manage all games and set the default game settings.'),
      'restrict access' => TRUE,
    ),
    'facilitate beer games' => array(
      'title' => t('Facilitate Beer Games'),
      'description' => t('Create games, assign people to teams and run their own games.'),
    ),
    'play beer games' => array(
      'title' => t('Play Beer Games'),
      'description' => t('Play in games where a facilitator has assigned them a position.'),
    ),
  );
}

/**
 * Implements hook_entity_info().
 */
function beergame_entity_info() {
  return array(
    'beergame_game' => array(
      'label' => t('Beer Game'),
      'entity class' => 'BeerGame',
      'controller class' => 'BeerGameStorageController',
      'base table' => 'beergame_game',
      'fieldable' => FALSE,
      'entity keys' => array(
        'id' => 'gid',
        'label' => 'title',
      ),
    ),
  );
}

